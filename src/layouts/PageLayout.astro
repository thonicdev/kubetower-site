---
/**
 * A standard content page: a header block, then whatever is slotted under it.
 * Used by /download and /404.
 */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  heading: string;
  lede?: string;
}

const { title, description, eyebrow, heading, lede } = Astro.props;
---

<BaseLayout {title} {description}>
  <div class="relative overflow-hidden border-b border-outline-variant/50">
    <div
      class="pointer-events-none absolute -top-32 left-1/2 h-[320px] w-[720px] -translate-x-1/2 rounded-full bg-primary/10 blur-[140px]"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-6 pt-16 pb-12">
      {
        eyebrow && (
          <span class="font-mono text-xs font-semibold tracking-wider text-primary uppercase">{eyebrow}</span>
        )
      }
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">{heading}</h1>
      {lede && <p class="mt-4 max-w-2xl leading-relaxed text-on-surface-variant">{lede}</p>}
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6 py-12">
    <slot />
  </div>
</BaseLayout>
