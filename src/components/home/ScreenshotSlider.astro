---
/**
 * The captures, in a Swiper slider.
 *
 * Only the four modules the slider uses are imported — navigation, pagination,
 * keyboard, a11y — rather than `swiper/bundle`, which carries every effect and
 * the autoplay, virtual, thumbs and zoom modules the page never asks for. Same
 * for the stylesheet: `swiper/css` is the layout, and the arrows and the
 * bullets are ours, so their stylesheets are not pulled in.
 *
 * The slides are in the markup and the images go through astro:assets, so the
 * captures are responsive webp with a srcset whether Swiper loads or not.
 */
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { screenshots } from '~/config/screenshots';
---

<section id="console" class="mx-auto max-w-6xl scroll-mt-24 px-6 pt-10 pb-4">
  <div class="group/slider mx-auto max-w-5xl" data-slider>
    <div
      class="relative overflow-hidden rounded-xl border border-outline-variant/80 bg-surface-container-lowest shadow-2xl transition-colors duration-300 hover:border-outline-variant"
    >
      <!-- Frame chrome -->
      <div
        class="flex items-center justify-between border-b border-outline-variant bg-surface-container-high px-4 py-2.5 font-mono text-xs text-on-surface-variant"
      >
        <div class="flex items-center gap-2">
          <div class="mr-2 flex items-center gap-1.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-[#ef4444]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#eab308]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#22c55e]"></span>
          </div>
          <span class="font-medium text-white">kubetower</span>
        </div>

        <span class="hidden font-mono text-[11px] text-on-surface-variant/70 sm:inline">
          <span data-slider-position>1</span> / {screenshots.length}
        </span>
      </div>

      <!-- Track -->
      <div class="swiper" data-slider-swiper>
        <div class="swiper-wrapper">
          {
            screenshots.map((shot, index) => (
              <div class="swiper-slide">
                <Image
                  src={shot.image}
                  alt={shot.alt}
                  widths={[720, 1080, 1440, shot.image.width]}
                  sizes="(max-width: 1024px) 100vw, 1024px"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding={index === 0 ? 'sync' : 'async'}
                  class="block h-auto w-full"
                />
              </div>
            ))
          }
        </div>
      </div>

      <!-- Arrows. Ours rather than Swiper's, so they carry the theme; Swiper
           drives them and sets the disabled class at the ends. -->
      <button
        type="button"
        data-slider-prev
        class="absolute top-1/2 left-3 z-10 hidden -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-outline-variant bg-surface-container-lowest/90 p-2 text-white opacity-0 backdrop-blur transition-all duration-200 group-hover/slider:opacity-100 hover:border-primary/60 hover:text-primary sm:flex"
      >
        <Icon name="lucide:chevron-left" size={18} />
      </button>
      <button
        type="button"
        data-slider-next
        class="absolute top-1/2 right-3 z-10 hidden -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-outline-variant bg-surface-container-lowest/90 p-2 text-white opacity-0 backdrop-blur transition-all duration-200 group-hover/slider:opacity-100 hover:border-primary/60 hover:text-primary sm:flex"
      >
        <Icon name="lucide:chevron-right" size={18} />
      </button>
    </div>

    <!-- Bullets -->
    <div class="mt-5 flex items-center justify-center gap-2" data-slider-pagination></div>
  </div>
</section>

<style is:global>
  /* Swiper builds the bullets itself, so these cannot be scoped styles — a
     scoped rule is keyed to an attribute Astro stamps on the markup at build,
     and an element created at runtime never carries it. */
  .kt-bullet {
    height: 0.375rem;
    width: 0.375rem;
    border-radius: 9999px;
    background: var(--color-outline);
    cursor: pointer;
    transition:
      width 0.3s ease,
      background-color 0.3s ease;
  }

  .kt-bullet:hover {
    background: var(--color-on-surface-variant);
  }

  .kt-bullet-active,
  .kt-bullet-active:hover {
    width: 2rem;
    background: var(--color-primary);
  }

  /* Until Swiper initialises — and if it never does — the track stays a
     scrollable, snapping strip rather than one image with two dead arrows
     beside it. Swiper adds `swiper-initialized` and takes over from there. */
  .swiper:not(.swiper-initialized) .swiper-wrapper {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .swiper:not(.swiper-initialized) .swiper-slide {
    scroll-snap-align: center;
  }

  .swiper-button-disabled {
    pointer-events: none;
    opacity: 0 !important;
  }
</style>

<script>
  import Swiper from 'swiper';
  import { A11y, Keyboard, Navigation, Pagination } from 'swiper/modules';
  import 'swiper/css';

  import { screenshots } from '~/config/screenshots';

  const root = document.querySelector<HTMLElement>('[data-slider]');
  const container = root?.querySelector<HTMLElement>('[data-slider-swiper]');

  if (root && container) {
    const position = root.querySelector<HTMLElement>('[data-slider-position]');

    new Swiper(container, {
      modules: [Navigation, Pagination, Keyboard, A11y],
      slidesPerView: 1,
      speed: 420,
      grabCursor: true,
      /* No loop: the arrows disable at the ends, which tells you how many there
         are. A carousel that wraps silently never does. */
      loop: false,
      keyboard: { enabled: true, onlyInViewport: true },
      a11y: {
        containerMessage: 'Screenshots of the console',
        prevSlideMessage: 'Previous screenshot',
        nextSlideMessage: 'Next screenshot',
        slideLabelMessage: '{{index}} of {{slidesLength}}',
      },
      navigation: {
        prevEl: '[data-slider-prev]',
        nextEl: '[data-slider-next]',
      },
      pagination: {
        el: '[data-slider-pagination]',
        clickable: true,
        bulletClass: 'kt-bullet',
        bulletActiveClass: 'kt-bullet-active',
        renderBullet: (index, className) =>
          `<button type="button" class="${className}" aria-label="${screenshots[index]?.title ?? `Screenshot ${index + 1}`}"></button>`,
      },
      on: {
        /* `activeIndex`, not a counter of our own: a drag, a bullet, an arrow
           and the keyboard all land here, and only Swiper knows where it
           stopped. */
        slideChange(swiper) {
          if (position) position.textContent = String(swiper.activeIndex + 1);
        },
      },
    });
  }
</script>
