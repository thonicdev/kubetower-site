---
/**
 * Desktop against in-cluster, as one table a reader can scan in a second.
 *
 * It was two cards of key/value pairs set in the mono face, and a comparison
 * whose two columns sit side by side is read by looking down a column, not by
 * reading prose twice. So: one row per question, a tick or a cross in each
 * column, and a short note only where the mark alone would mislead. The face
 * is the sans one — mono is for commands, and there are none here.
 *
 * `md:contents` is what makes it one markup rather than two: below md each row
 * is its own card with the column named inside every cell, and at md the row
 * box dissolves and its three cells become columns of the surrounding grid.
 */
import Icon from '../Icon.astro';
import { comparison, profiles, profilesIntro, type Answer } from '~/config/profiles';
import { withBase } from '~/lib/paths';

/**
 * The three verdicts: the mark, the word a screen reader gets instead — and
 * `word`, the colour that word takes when it is on screen, which is only below
 * md. There, a column has no header to inherit its meaning from, so the answer
 * has to say itself.
 */
const marks: Record<Answer, { icon: string; chip: string; label: string; word: string }> = {
  yes: { icon: 'lucide:check', chip: 'bg-tertiary/15 text-tertiary', label: 'Yes', word: 'text-tertiary' },
  partial: {
    icon: 'lucide:minus',
    chip: 'bg-warning/15 text-warning',
    label: 'Limited',
    word: 'text-warning',
  },
  no: { icon: 'lucide:x', chip: 'bg-error/15 text-error', label: 'No', word: 'text-error' },
};

const heads = {
  primary: { chip: 'bg-primary/15 text-primary', sub: 'text-primary' },
  tertiary: { chip: 'bg-tertiary/15 text-tertiary', sub: 'text-tertiary' },
} as const;

const hairline = 'border-outline-variant/60';
/** The featured column is tinted the whole way down, header to call to action. */
const column = (featured?: boolean) => (featured ? 'bg-primary/[0.04]' : '');
---

<section id="profiles" class="mx-auto max-w-6xl scroll-mt-24 border-t border-outline-variant/50 px-6 py-16">
  <div class="mx-auto mb-12 max-w-3xl text-center">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{profilesIntro.title}</h2>
    <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-on-surface-variant">
      {profilesIntro.lede}
    </p>
  </div>

  <div
    class="mx-auto max-w-5xl overflow-hidden rounded-2xl border border-outline-variant bg-surface-container-low shadow-xl"
  >
    <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)_minmax(0,1fr)]">
      <!-- The header: the empty corner, then one identity per column. -->
      <div class:list={['hidden md:block border-b', hairline]}></div>
      {
        profiles.map((profile) => (
          <div
            class:list={[
              'border-b p-5 sm:p-6 md:border-l',
              hairline,
              column(profile.featured),
            ]}
          >
            <div class="flex items-center gap-3">
              <span
                class:list={[
                  'flex h-11 w-11 shrink-0 items-center justify-center rounded-xl',
                  heads[profile.tone].chip,
                ]}
              >
                <Icon name={profile.icon} size={24} />
              </span>
              <div class="min-w-0">
                <h3 class="text-lg font-bold text-white">{profile.title}</h3>
                <p class:list={['text-sm font-medium', heads[profile.tone].sub]}>{profile.subtitle}</p>
              </div>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-on-surface-variant">{profile.audience}</p>
          </div>
        ))
      }

      <!-- One row per question. -->
      {
        comparison.map((row) => (
          <div class:list={['border-b p-4 last:border-b-0 sm:p-5 md:contents', hairline]}>
            <div
              class:list={[
                'text-base font-semibold text-white md:flex md:items-center md:border-b md:px-6 md:py-4 md:text-sm',
                hairline,
              ]}
            >
              {row.label}
            </div>
            {profiles.map((profile) => {
              const verdict = row.answers[profile.id];
              const mark = marks[verdict.answer];
              return (
                <div
                  class:list={[
                    'mt-4 flex items-start gap-3 md:mt-0 md:border-b md:border-l md:px-6 md:py-4',
                    hairline,
                    column(profile.featured),
                  ]}
                >
                  <span
                    class:list={[
                      'mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full',
                      mark.chip,
                    ]}
                  >
                    <Icon name={mark.icon} size={15} />
                    <span class="sr-only">{mark.label}</span>
                  </span>
                  <div class="min-w-0">
                    {/* Below md only, and `aria-hidden` because the chip beside
                        it already carries the same word for a reader. */}
                    <p class="flex items-baseline gap-2 md:hidden" aria-hidden="true">
                      <span class="text-sm font-semibold text-white">{profile.short}</span>
                      <span class:list={['text-[11px] font-bold tracking-wider uppercase', mark.word]}>
                        {mark.label}
                      </span>
                    </p>
                    {verdict.note && (
                      <p class="mt-0.5 text-sm leading-snug text-on-surface-variant md:mt-0">
                        {verdict.note}
                      </p>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        ))
      }

      <!-- The call to action, one per column, in the column it belongs to. -->
      <div class="hidden md:block"></div>
      {
        profiles.map((profile) => (
          <div class:list={['p-4 sm:p-5 md:border-l md:p-6', hairline, column(profile.featured)]}>
            {profile.cta.href ? (
              <a
                href={withBase(profile.cta.href)}
                class="flex w-full items-center justify-center gap-2 rounded-xl bg-primary py-3 text-center text-sm font-bold text-on-primary shadow-md transition-all hover:bg-primary-fixed hover:shadow-[0_0_15px_rgba(76,215,246,0.35)] active:scale-95"
              >
                <Icon name={profile.cta.icon} size={18} />
                {profile.cta.label}
              </a>
            ) : (
              <button
                type="button"
                data-copy={profile.cta.copy}
                class="group/copy flex w-full items-center justify-center gap-2 rounded-xl border border-outline-variant bg-surface-container py-3 text-sm font-semibold text-white transition-all hover:border-tertiary/50 hover:bg-surface-container-high active:scale-95"
              >
                <Icon name={profile.cta.icon} size={18} class="text-tertiary" data-copy-icon />
                <Icon name="lucide:check" size={18} class="hidden text-tertiary" data-copy-done />
                <span data-copy-label>{profile.cta.label}</span>
              </button>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
