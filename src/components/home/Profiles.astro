---
/**
 * Desktop against in-cluster, as one table a reader can scan in a second.
 *
 * It was two cards of key/value pairs set in the mono face, and a comparison
 * whose two columns sit side by side is read by looking down a column, not by
 * reading prose twice. So: one row per question, a tick or a cross in each
 * column, and a short note only where the mark alone would mislead. The face
 * is the sans one — mono is for commands, and there are none here.
 *
 * `md:contents` is what makes it one markup rather than two: below md each row
 * is its own card, and at md the row box dissolves and its three cells become
 * columns of the surrounding grid.
 *
 * Below md the two surfaces are **marks only** — a question, a tick, a cross,
 * three columns and no prose. The notes are what a phone has no room for and
 * what made this unreadable twice, so they are behind the mark: tap one and its
 * sentence opens under the row. A column header names the two icons once, at
 * the top, because nothing else in a row can.
 *
 * The two breakpoints therefore hold different markup rather than one markup
 * bent twice: each answer is rendered as a mobile button and again as a desktop
 * cell, one `md:hidden` and the other `hidden md:flex`. That costs the note
 * text twice in the document and buys two layouts that cannot interfere — no
 * padding or border rule has to out-rank another, and an element hidden at a
 * breakpoint is `display: none`, so it is not a grid item there at all. That
 * last point is what keeps `md:contents` honest: at md the outer grid sees
 * exactly the question and the two desktop cells.
 */
import Icon from '../Icon.astro';
import { comparison, profiles, profilesIntro, type Answer } from '~/config/profiles';
import { withBase } from '~/lib/paths';

/** The three verdicts, each with the word a screen reader gets instead. */
const marks: Record<Answer, { icon: string; chip: string; label: string }> = {
  yes: { icon: 'lucide:check', chip: 'bg-tertiary/15 text-tertiary', label: 'Yes' },
  partial: { icon: 'lucide:minus', chip: 'bg-warning/15 text-warning', label: 'Limited' },
  no: { icon: 'lucide:x', chip: 'bg-error/15 text-error', label: 'No' },
};

const heads = {
  primary: { chip: 'bg-primary/15 text-primary', sub: 'text-primary' },
  tertiary: { chip: 'bg-tertiary/15 text-tertiary', sub: 'text-tertiary' },
} as const;

const hairline = 'border-outline-variant/60';
/** The featured column is tinted the whole way down, header to call to action. */
const column = (featured?: boolean) => (featured ? 'bg-primary/[0.04]' : '');
---

<section id="profiles" class="mx-auto max-w-6xl scroll-mt-24 border-t border-outline-variant/50 px-6 py-16">
  <div class="mx-auto mb-12 max-w-3xl text-center">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{profilesIntro.title}</h2>
    <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-on-surface-variant">
      {profilesIntro.lede}
    </p>
  </div>

  <div
    class="mx-auto max-w-5xl overflow-hidden rounded-2xl border border-outline-variant bg-surface-container-low shadow-xl"
  >
    <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)_minmax(0,1fr)]">
      <!-- The header: the empty corner, then one identity per column. -->
      <div class:list={['hidden md:block border-b', hairline]}></div>
      {
        profiles.map((profile) => (
          <div
            class:list={[
              'border-b p-5 sm:p-6 md:border-l',
              hairline,
              column(profile.featured),
            ]}
          >
            <div class="flex items-center gap-3">
              <span
                class:list={[
                  'flex h-11 w-11 shrink-0 items-center justify-center rounded-xl',
                  heads[profile.tone].chip,
                ]}
              >
                <Icon name={profile.icon} size={24} />
              </span>
              <div class="min-w-0">
                <h3 class="text-lg font-bold text-white">{profile.title}</h3>
                <p class:list={['text-sm font-medium', heads[profile.tone].sub]}>{profile.subtitle}</p>
              </div>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-on-surface-variant">{profile.audience}</p>
          </div>
        ))
      }

      <!-- The column header, below md only: the table has no other way to say
           which mark belongs to which surface. -->
      <div
        class:list={[
          'grid grid-cols-[1fr_3rem_3rem] items-center gap-x-2 border-b px-4 py-2.5 sm:px-5 md:hidden',
          hairline,
        ]}
      >
        <span class="text-[11px] font-medium tracking-wider text-on-surface-variant/70 uppercase">
          Tap a mark
        </span>
        {profiles.map((profile) => (
          <span class="flex justify-center">
            <Icon name={profile.icon} size={18} class={heads[profile.tone].sub} />
            <span class="sr-only">{profile.title}</span>
          </span>
        ))}
      </div>

      <!-- One row per question. -->
      {
        comparison.map((row, index) => (
          <div
            class:list={[
              'grid grid-cols-[1fr_3rem_3rem] items-center gap-x-2 border-b px-4 py-3 last:border-b-0 sm:px-5 md:contents',
              hairline,
            ]}
          >
            <div
              class:list={[
                'text-sm font-semibold text-white md:flex md:items-center md:border-b md:px-6 md:py-4',
                hairline,
              ]}
            >
              {row.label}
            </div>

            {/* Below md: the mark alone, and a button wherever there is a note
                to open. A mark with nothing behind it is not a control. */}
            {profiles.map((profile) => {
              const verdict = row.answers[profile.id];
              const mark = marks[verdict.answer];
              const chip = [
                'flex h-7 w-7 items-center justify-center rounded-full',
                mark.chip,
              ];
              return verdict.note ? (
                <button
                  type="button"
                  class="flex cursor-pointer justify-center transition-transform active:scale-90 md:hidden"
                  aria-expanded="false"
                  aria-controls={`cmp-${index}-${profile.id}`}
                  data-note-toggle
                >
                  <span class:list={chip}>
                    <Icon name={mark.icon} size={16} />
                  </span>
                  <span class="sr-only">
                    {profile.title}: {mark.label}. Show detail
                  </span>
                </button>
              ) : (
                <span class="flex justify-center md:hidden">
                  <span class:list={chip}>
                    <Icon name={mark.icon} size={16} />
                  </span>
                  <span class="sr-only">
                    {profile.title}: {mark.label}
                  </span>
                </span>
              );
            })}

            {/* The notes the marks open, below md only. */}
            {profiles.map((profile) => {
              const verdict = row.answers[profile.id];
              return (
                verdict.note && (
                  <p
                    id={`cmp-${index}-${profile.id}`}
                    hidden
                    class="col-span-3 mt-2.5 text-xs leading-snug text-on-surface-variant md:hidden"
                  >
                    <span class:list={['font-semibold', heads[profile.tone].sub]}>{profile.short}</span>
                    <span class="mx-1.5 text-outline">—</span>
                    {verdict.note}
                  </p>
                )
              );
            })}

            {/* At md and up: the cell as it has always been, and every class
                here is free of a breakpoint because the element is `hidden`
                below one. */}
            {profiles.map((profile) => {
              const verdict = row.answers[profile.id];
              const mark = marks[verdict.answer];
              return (
                <div
                  class:list={[
                    'hidden border-b border-l px-6 py-4 md:flex md:items-center md:gap-3',
                    hairline,
                    column(profile.featured),
                  ]}
                >
                  <span
                    class:list={[
                      'flex h-6 w-6 shrink-0 items-center justify-center rounded-full',
                      mark.chip,
                    ]}
                  >
                    <Icon name={mark.icon} size={15} />
                    <span class="sr-only">{mark.label}</span>
                  </span>
                  {verdict.note && (
                    <p class="min-w-0 text-sm leading-snug text-on-surface-variant">{verdict.note}</p>
                  )}
                </div>
              );
            })}
          </div>
        ))
      }

      <!-- The call to action, one per column, in the column it belongs to. -->
      <div class="hidden md:block"></div>
      {
        profiles.map((profile) => (
          <div class:list={['p-4 sm:p-5 md:border-l md:p-6', hairline, column(profile.featured)]}>
            {profile.cta.href ? (
              <a
                href={withBase(profile.cta.href)}
                class="flex w-full items-center justify-center gap-2 rounded-xl bg-primary py-3 text-center text-sm font-bold text-on-primary shadow-md transition-all hover:bg-primary-fixed hover:shadow-[0_0_15px_rgba(76,215,246,0.35)] active:scale-95"
              >
                <Icon name={profile.cta.icon} size={18} />
                {profile.cta.label}
              </a>
            ) : (
              <button
                type="button"
                data-copy={profile.cta.copy}
                class="group/copy flex w-full items-center justify-center gap-2 rounded-xl border border-outline-variant bg-surface-container py-3 text-sm font-semibold text-white transition-all hover:border-tertiary/50 hover:bg-surface-container-high active:scale-95"
              >
                <Icon name={profile.cta.icon} size={18} class="text-tertiary" data-copy-icon />
                <Icon name="lucide:check" size={18} class="hidden text-tertiary" data-copy-done />
                <span data-copy-label>{profile.cta.label}</span>
              </button>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  /* Below md the marks are the whole table, so the sentence behind a mark has
     to be reachable from it. `hidden` on the paragraph rather than a class:
     the attribute is what `aria-expanded` is describing, and the two cannot
     drift apart if one of them is what the browser reads. */
  document.querySelectorAll<HTMLButtonElement>('[data-note-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.getAttribute('aria-controls');
      const note = id ? document.getElementById(id) : null;
      if (!note) return;

      const open = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!open));
      note.hidden = open;
    });
  });
</script>
