---
/**
 * The extras as a grid of their own captures: seen at a glance, read in one
 * line each. A card links to nothing — the console is where they open.
 */
import { Image } from 'astro:assets';
import { extras, extrasIntro } from '~/config/extras';
---

<section id="extras" class="mx-auto max-w-6xl scroll-mt-24 border-t border-outline-variant/50 px-6 py-16">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{extrasIntro.title}</h2>
    <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-on-surface-variant">{extrasIntro.lede}</p>
  </div>

  <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
    {
      extras.map((extra) => (
        <li class="overflow-hidden rounded-xl border border-outline-variant/70 bg-surface-container transition-colors hover:border-primary/40">
          <Image
            src={extra.image}
            alt=""
            width={480}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 220px, (min-width: 640px) 50vw, 100vw"
            format="webp"
            loading="lazy"
            class="block aspect-[16/10] h-auto w-full border-b border-outline-variant/60 object-cover object-top"
          />
          <div class="p-3.5">
            <h3 class="text-sm font-semibold text-white">{extra.name}</h3>
            <p class="mt-1 text-xs leading-relaxed text-on-surface-variant">{extra.line}</p>
          </div>
        </li>
      ))
    }
  </ul>

  <p class="mt-6 text-center text-sm text-on-surface-variant">{extrasIntro.next}</p>
</section>
