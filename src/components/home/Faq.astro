---
/**
 * The closing section: six questions, native accordions, no script.
 *
 * `<details>` rather than a button and a hidden panel, because the browser
 * already implements every part of this — the keyboard, the ARIA, the state,
 * and finding text inside a collapsed answer. A hand-rolled accordion is
 * markup that has to re-earn all four.
 *
 * `name="faq"` makes the group exclusive: opening one closes the last. Where
 * a browser does not know the attribute yet it is ignored, and the section
 * degrades to several answers open at once, which is not a failure.
 *
 * The heading column is sticky on large screens so the question list scrolls
 * against something fixed. Below `lg` it is simply the first block.
 */
import Icon from '../Icon.astro';
import { faq, faqIntro } from '~/config/faq';
import { project, repoLinks } from '~/config/project';
import { withBase } from '~/lib/paths';
---

<section id="faq" class="mx-auto max-w-6xl scroll-mt-24 border-t border-outline-variant/50 px-6 py-16">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-16">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{faqIntro.title}</h2>
      <p class="mt-3 text-base leading-relaxed text-on-surface-variant">{faqIntro.lede}</p>

      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
        <a
          href={withBase('/docs')}
          class="inline-flex items-center gap-2 font-medium text-primary transition-colors hover:text-primary-fixed"
        >
          <Icon name="lucide:book-open" size={16} />
          Read the documentation
        </a>
        {
          project.repoPublic && (
            <a
              href={repoLinks.issues}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 font-medium text-on-surface-variant transition-colors hover:text-white"
            >
              <Icon name="lucide:message-circle-question" size={16} />
              Ask on GitHub
            </a>
          )
        }
      </div>
    </div>

    <ul class="divide-y divide-outline-variant/60 border-y border-outline-variant/60">
      {
        faq.map((item) => (
          <li>
            <details name="faq" class="group py-1">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 rounded-lg py-4 text-base font-semibold text-white transition-colors hover:text-primary [&::-webkit-details-marker]:hidden">
                {item.question}
                <Icon
                  name="lucide:plus"
                  size={18}
                  class="shrink-0 text-on-surface-variant transition-transform duration-200 group-open:rotate-45 group-open:text-primary"
                />
              </summary>
              <p class="max-w-2xl pr-10 pb-5 text-sm leading-relaxed text-on-surface-variant">{item.answer}</p>
            </details>
          </li>
        ))
      }
    </ul>
  </div>
</section>
