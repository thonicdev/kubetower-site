---
/**
 * Inline SVG icons, bundled at build time from Iconify's data packages.
 *
 * Icons are inlined rather than loaded from an icon font, which is the one
 * thing a site selling "nothing leaves your machine" cannot do with a straight
 * face: a webfont from a CDN is a request to a third party on every visit. The
 * JSON is read here, at build time, and never reaches the browser.
 *
 * Names are `set:icon`, e.g. `lucide:shield` or `simple-icons:apple`. An
 * unknown name fails the build instead of rendering an empty box.
 */
import type { HTMLAttributes } from 'astro/types';
import lucide from '@iconify-json/lucide/icons.json';
import simpleIcons from '@iconify-json/simple-icons/icons.json';

interface IconData {
  body: string;
  width?: number;
  height?: number;
}

interface IconSet {
  width?: number;
  height?: number;
  icons: Record<string, IconData>;
  aliases?: Record<string, { parent: string }>;
}

const sets: Record<string, IconSet> = {
  lucide: lucide as IconSet,
  'simple-icons': simpleIcons as IconSet,
};

interface Props extends HTMLAttributes<'svg'> {
  name: string;
  class?: string;
  size?: number;
  /** Give the icon an accessible name; otherwise it is hidden from readers. */
  title?: string;
}

const { name, class: className, size = 20, title, ...rest } = Astro.props;

const separator = name.indexOf(':');
const setName = separator === -1 ? '' : name.slice(0, separator);
const iconName = name.slice(separator + 1);
const set = sets[setName];

if (!set) {
  throw new Error(`Icon set "${setName}" is not bundled (asked for "${name}")`);
}

const alias = set.aliases?.[iconName]?.parent;
const icon = set.icons[iconName] ?? (alias ? set.icons[alias] : undefined);

if (!icon) {
  throw new Error(`Unknown icon "${name}"`);
}

const width = icon.width ?? set.width ?? 24;
const height = icon.height ?? set.height ?? 24;
---

<svg
  viewBox={`0 0 ${width} ${height}`}
  width={size}
  height={size}
  class={className}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
  {...rest}
  set:html={icon.body}
/>
