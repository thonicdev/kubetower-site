    "@iconify-json/lucide": "^1.2.131",
    "@iconify-json/simple-icons": "^1.2.95",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "sharp": "^0.35.4",
    "swiper": "^14.2.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
