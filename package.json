{
  "name": "kubetower-site",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "The kubetower website, a static Astro site published to GitHub Pages.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
